---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getPosts } from '../lib/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<Base title={t('blog.title')}>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="display mb-12 text-[clamp(3rem,8vw,5.5rem)]">{t('blog.title')}</h1>
    {posts.length > 0 ? <PostList posts={posts} lang={lang} /> : <p class="text-muted">{t('blog.empty')}</p>}
  </div>
</Base>
