---
import { profile } from '../data/profile';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>© {year} {profile.fullName}. {t('footer.built')}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {
        profile.socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank" class="hover:text-ink">
              {s.label}
            </a>
          </li>
        ))
      }
      <li><a href={`mailto:${profile.email}`} class="hover:text-ink">Email</a></li>
      <li><a href={localizePath('/rss.xml', lang)} class="hover:text-ink">RSS</a></li>
    </ul>
  </div>
</footer>
