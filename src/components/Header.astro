---
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Path halaman yang sama dalam bahasa lain; null jika tidak ada terjemahan. */
  altPath: string | null;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
const otherLang = lang === 'id' ? 'en' : 'id';
const switchHref = Astro.props.altPath ?? localizePath('/', otherLang);

const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: localizePath('/blog/', lang), label: t('nav.blog') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="font-display text-lg no-underline">
      {profile.shortName}
    </a>

    <nav aria-label={t('nav.menu')} class="hidden md:block">
      <ul class="flex items-center gap-6 text-[0.95rem]">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="text-muted no-underline transition-colors hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={switchHref}
        hreflang={otherLang}
        lang={otherLang}
        title={t('lang.switch')}
        aria-label={t('lang.switch')}
        class="rounded-md px-2.5 py-1.5 text-sm font-semibold text-muted no-underline hover:text-ink"
      >
        {otherLang.toUpperCase()}
      </a>
      <ThemeToggle label={t('theme.toggle')} />
      <button
        type="button"
        id="menu-btn"
        class="grid size-10 place-items-center rounded-md text-muted hover:text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.menu')}
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={t('nav.menu')} class="hidden border-t border-line md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block py-2.5 text-lg no-underline">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
  }
</script>
