---
import { skillGroups } from '../data/skills';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="skills" class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <h2 class="section-title">{t('skills.title')}</h2>
    <div class="grid gap-8 sm:grid-cols-2">
      {
        skillGroups.map((g) => (
          <div>
            <h3 class="mb-3 text-muted">{g.name[lang]}</h3>
            <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xl font-semibold">
              {g.items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
