---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { formatDate, localizePath } from '../i18n/utils';
import { postSlug } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'blog'>[];
  lang: Lang;
}
const { posts, lang } = Astro.props;
---

<ul>
  {
    posts.map((post) => (
      <li class="border-t border-line">
        <a
          href={localizePath(`/blog/${postSlug(post)}/`, lang)}
          class="group grid gap-1 py-6 no-underline sm:grid-cols-[10rem_1fr] sm:gap-8"
        >
          <time datetime={post.data.date.toISOString()} class="text-sm text-muted tabular-nums sm:pt-1">
            {formatDate(post.data.date, lang)}
          </time>
          <span>
            <span class="block text-xl font-bold leading-snug group-hover:text-accent">{post.data.title}</span>
            <span class="mt-1 block text-muted">{post.data.description}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
